# ============================================================================
# MonTotem - Configuration (copier ce fichier vers assets/.env)
# ============================================================================
# ATTENTION : assets/.env est embarque dans l'application (bundle Flutter).
# Ne jamais y placer un secret (cle privee, cle secrete R2/KKiaPay,
# service_role Supabase). Seules des cles PUBLIQUES y sont admises.
# ============================================================================

# --- Supabase (base de donnees + auth + storage) ---------------------
SUPABASE_URL=https://zyjivkpmgzucfiubhbsg.supabase.co
# Cle publique (anon / publishable) — pas la service_role !
SUPABASE_ANON_KEY=sb_publishable_eCPV6AO8alJwk9YJnyB4zA__i3X9Vpo

# --- KKiaPay (paiement Mobile Money) ----------------------------------
# Cle publique SDK ; KKIAPAY_SANDBOX=true avant mise en production.
KKIAPAY_PUBLIC_KEY=7bfcef102d3011f18ba329d9c41dd078
KKIAPAY_SANDBOX=true

# --- Bouton Google sur l'ecran d'inscription rapide -------------------
# false desactive la fonction sans recompiler (lu par quick_signup_screen).
GOOGLE_LOGIN_ENABLED=true

# --- Aucun backend Django / API_BASE_URL ------------------------------
